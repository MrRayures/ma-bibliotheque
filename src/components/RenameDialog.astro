---
import Button from './Button.astro';
import Icon from './Icon.astro';
---

<dialog
  id="rename-dialog"
  class="c-dialog  c-dialog--md"
  aria-labelledby="rename-title"
>
  <div class="c-dialog__header">
    <h2 id="rename-title" class="c-dialog__title">Renommer la collection</h2>
    <Button id="rename-close" variant="ghost" size="md" aria-label="Fermer">
      <Icon name="close" size={24} slot="icon" />
    </Button>
  </div>
  <div class="c-dialog__body">
    <label for="rename-input" class="text-sm text-text-light">Nouveau nom</label>
    <input
      type="text"
      id="rename-input"
      autocomplete="off"
      class="c-input"
    />
    <div class="flex gap-2">
      <Button id="rename-cancel" variant="secondary-outline" size="md" class="flex-1">
        Annuler
      </Button>
      <Button id="rename-confirm" variant="primary" size="md" class="flex-1">
        Renommer
      </Button>
    </div>
  </div>
</dialog>

<script>
  import { renameCollection } from '../utils/api';

  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('rename-dialog') as HTMLDialogElement;
    const input = document.getElementById('rename-input') as HTMLInputElement;

    let activeSlug: string | null = null;
    let activeName: string | null = null;

    function close(): void {
      dialog.close();
      activeSlug = null;
      activeName = null;
    }

    document.addEventListener('open-rename-dialog', (e) => {
      const { slug, name } = (e as CustomEvent<{ slug: string; name: string }>).detail;
      activeSlug = slug;
      activeName = name;
      input.value = name;
      dialog.showModal();
      input.select();
    });

    document.getElementById('rename-close')?.addEventListener('click', close);
    document.getElementById('rename-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('rename-confirm')?.click();
      if (e.key === 'Escape') close();
    });

    document.getElementById('rename-confirm')?.addEventListener('click', async () => {
      if (!activeSlug) return;
      const newName = input.value.trim();
      if (!newName || newName === activeName) { close(); return; }

      await renameCollection(activeSlug, newName);
      close();
      document.dispatchEvent(new CustomEvent('collection-renamed', { detail: { slug: activeSlug, newName } }));
    });
  });
</script>
