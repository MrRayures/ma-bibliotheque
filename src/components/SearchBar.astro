---
import Icon from './Icon.astro';

interface Props {
  placeholder?: string;
}

const { placeholder = 'Rechercher...' } = Astro.props;
---

<div class="relative">
  <Icon name="search" size={24} class="absolute left-3 top-1/2 -translate-y-1/2 " />
  <input
    type="search"
    id="search-input"
    placeholder={placeholder}
    autocomplete="off"
    class="c-input--search"
    aria-label={placeholder}
  />
</div>

<p id="search-empty" class="mt-6 text-sm text-text-light" hidden>
  Aucun résultat pour cette recherche.
</p>

<script>
  document.addEventListener('astro:page-load', () => {
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const emptyState = document.querySelector<HTMLElement>('#search-empty');

    function filterItems(query: string): void {
      const items = document.querySelectorAll<HTMLElement>('[data-search]');
      let visibleCount = 0;

      items.forEach((item) => {
        const text = item.dataset.search?.toLowerCase() ?? '';
        const matches = query === '' || text.includes(query);
        item.hidden = !matches;
        if (matches) visibleCount++;
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
    }

    input?.addEventListener('input', () => {
      filterItems(input.value.toLowerCase().trim());
    });
  });
</script>
