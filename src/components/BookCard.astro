---
import type { Book, BookType } from '../types/library';

interface Props {
  book: Book;
}

const { book } = Astro.props;

const typeLabels: Record<BookType, string> = {
  comics: 'Comics',
  manga: 'Manga',
  bd: 'BD',
};

const typeBadgeClasses: Record<BookType, string> = {
  comics: 'bg-blue-100 text-blue-700',
  manga: 'bg-purple-100 text-purple-700',
  bd: 'bg-amber-100 text-amber-700',
};

const placeholderClasses: Record<BookType, string> = {
  comics: 'from-blue-100 to-blue-200 text-blue-400',
  manga: 'from-purple-100 to-purple-200 text-purple-400',
  bd: 'from-amber-100 to-amber-200 text-amber-400',
};
---

<article
  class="flex flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white transition-shadow hover:shadow-md"
>
  <div class="relative aspect-[2/3] bg-neutral-100">
    {
      book.cover ? (
        <img
          src={book.cover}
          alt={`Couverture de ${book.title}`}
          width="200"
          height="300"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      ) : (
        <div
          class={`flex h-full w-full items-center justify-center bg-gradient-to-br ${placeholderClasses[book.type]}`}
        >
          <span class="text-4xl font-bold" aria-hidden="true">
            {book.title[0].toUpperCase()}
          </span>
        </div>
      )
    }
    {
      book.status === 'missing' && (
        <div class="absolute inset-0 flex items-center justify-center bg-black/50">
          <span class="rounded bg-red-500 px-2 py-1 text-xs font-bold uppercase tracking-wider text-white">
            Manquant
          </span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 p-3">
    <div class="flex items-start justify-between gap-2">
      <h2 class="line-clamp-2 text-sm font-semibold leading-tight text-neutral-900">
        {book.title}
      </h2>
      <span
        class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${typeBadgeClasses[book.type]}`}
      >
        {typeLabels[book.type]}
      </span>
    </div>
    <p class="text-xs text-neutral-500">{book.authors.join(', ')}</p>
    {book.collection && <p class="text-xs text-neutral-400">Vol.&nbsp;{book.collection.volume}</p>}
  </div>
</article>
