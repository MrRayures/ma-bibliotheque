---
import BarcodeScanner from './BarcodeScanner.astro';
import AddBookModal from './AddBookModal.astro';
---

<BarcodeScanner />
<AddBookModal />

<button
  id="add-book-btn"
  type="button"
  aria-label="Ajouter un livre"
  class="fixed bottom-6 right-6 flex h-14 w-14 items-center justify-center rounded-full bg-neutral-900 text-white shadow-lg transition-transform hover:scale-105 hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 active:scale-95"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 5v14M5 12h14"/>
  </svg>
</button>

<script>
  document.getElementById('add-book-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-scanner'));
  });
</script>
