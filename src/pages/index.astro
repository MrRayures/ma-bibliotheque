---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
---

<BaseLayout title="Livres — Ma Bibliothèque">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-neutral-900">Livres</h1>
      <p id="book-count" class="text-sm text-neutral-500" aria-live="polite"></p>
    </div>
    <SearchBar placeholder="Rechercher par titre ou auteur..." />
    <ul
      id="book-grid"
      class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
      role="list"
      aria-label="Liste des livres"
    >
    </ul>
    <div
      id="books-loading"
      class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
      aria-label="Chargement en cours"
      aria-busy="true"
    >
      {Array.from({ length: 10 }).map(() => (
        <div class="aspect-square animate-pulse rounded-lg bg-neutral-200"></div>
      ))}
    </div>
    <div id="books-empty" class="mt-16 flex flex-col items-center gap-4 text-center" hidden>
      <p class="text-sm text-neutral-400">Aucun livre pour l'instant.</p>
      <a
        href="/ajouter"
        class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        Ajoutez votre premier livre
      </a>
    </div>

  </div>
</BaseLayout>

<script>
  import { getAllBooks, getEffectiveCoverUrl } from '../utils/api';
  import { isLoggedIn } from '../utils/auth';
  import { createBookListItem } from '../utils/render';

  async function init() {
    const books = await getAllBooks();
    const grid = document.getElementById('book-grid');
    const loading = document.getElementById('books-loading');
    const empty = document.getElementById('books-empty');
    const count = document.getElementById('book-count');
    const loggedIn = isLoggedIn();

    if (!grid) return;

    if (books.length === 0) {
      if (loading) loading.hidden = true;
      if (empty) {
        empty.hidden = false;
        const addFirstLink = empty.querySelector('a[href="/ajouter"]') as HTMLElement | null;
        if (addFirstLink) addFirstLink.hidden = !loggedIn;
      }
      return;
    }

    const fragment = document.createDocumentFragment();
    for (const book of books) {
      const coverUrl = getEffectiveCoverUrl(book);
      const li = createBookListItem(book, coverUrl, `${book.title} ${book.authors.join(' ')}`, loggedIn);
      fragment.appendChild(li);
    }

    grid.appendChild(fragment);
    if (loading) loading.hidden = true;
    if (count) count.textContent = `${books.length} livre${books.length > 1 ? 's' : ''}`;

    document.addEventListener('book-deleted', (e) => {
      const { id } = (e as CustomEvent<{ id: string }>).detail;
      grid.querySelector(`li[data-book-id="${id}"]`)?.remove();
      const remaining = grid.querySelectorAll('li').length;
      if (count) count.textContent = remaining > 0 ? `${remaining} livre${remaining > 1 ? 's' : ''}` : '';
      if (remaining === 0 && empty) empty.hidden = false;
    });
  }

  init();
</script>
