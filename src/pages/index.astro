---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SkeletonCard from '../components/SkeletonCard.astro';
---

<BaseLayout title="Livres — Ma Bibliothèque">
  <div class="mx-auto max-w-5xl px-4 pt-3 pb-28">
    <PageHeader title="Livres" countId="book-count" searchPlaceholder="Rechercher par titre ou auteur..." />

    <div id="book-grid" class="c-book-grid mt-4 space-y-8"></div>

    <div
      id="books-loading"
      class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(clamp(6.5rem,22vw,10rem),1fr))] gap-3"
      aria-label="Chargement en cours"
      aria-busy="true"
    >
      {Array.from({ length: 10 }).map(() => <SkeletonCard />)}
    </div>
    <div id="books-empty" class="mt-16 flex flex-col items-center gap-4 text-center" hidden>
      <p class="text-sm">C'est vide par ici ! <br>Ajouter un livre en cliquant sur le bouton ci-dessous.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { getAllBooks } from '../utils/api';
import { isLoggedIn } from '../utils/auth';
import { groupByLetter } from '../utils/books';
import { addPageScopedListener } from '../utils/dom-events';
import { buildLetterNav, createBookListItem, observeLetterSections, updateCardCover } from '../utils/render';

  document.addEventListener('astro:page-load', async () => {
    function updateSectionVisibility(): void {
      document.querySelectorAll<HTMLElement>('[data-letter-section]').forEach((section) => {
        const hasVisible = [...section.querySelectorAll<HTMLElement>('[data-search]')].some(
          (item) => !item.hidden,
        );
        section.hidden = !hasVisible;

        const letter = section.dataset.letterSection!;
        const navLink = document.querySelector<HTMLElement>(`[data-letter-nav="${letter}"]`);
        if (navLink) {
          navLink.classList.toggle('opacity-30', !hasVisible);
          navLink.classList.toggle('pointer-events-none', !hasVisible);
        }
      });
    }

    const books = await getAllBooks();
    const container = document.getElementById('book-grid');
    const loading = document.getElementById('books-loading');
    const empty = document.getElementById('books-empty');
    const count = document.getElementById('book-count');
    const nav = document.getElementById('letter-nav');
    const loggedIn = isLoggedIn();

    if (!container) return;

    if (books.length === 0) {
      if (loading) loading.hidden = true;
      if (empty) {
        empty.hidden = false;
        const addFirstLink = empty.querySelector('a[href="/ajouter"]') as HTMLElement | null;
        if (addFirstLink) addFirstLink.hidden = !loggedIn;
      }
      return;
    }

    const groups = groupByLetter(books);

    const sortedLetters = [...groups.keys()].sort((a, b) => {
      if (a === '#') return 1;
      if (b === '#') return -1;
      return a.localeCompare(b, 'fr');
    });

    if (nav) buildLetterNav(nav, new Set(sortedLetters));

    // Sections par lettre
    let totalBooks = books.length;
    const fragment = document.createDocumentFragment();
    for (const letter of sortedLetters) {
      const section = document.createElement('section');
      section.dataset.letterSection = letter;

      const heading = document.createElement('h2');
      heading.id = `lettre-${letter}`;
      heading.className = 'mb-3 font-semibold uppercase tracking-widest scroll-mt-20';
      heading.textContent = letter;
      section.appendChild(heading);

      const ul = document.createElement('ul');
      ul.className = 'grid grid-cols-[repeat(auto-fill,minmax(var(--card-size),1fr))] gap-3';
      ul.setAttribute('role', 'list');
      ul.setAttribute('aria-label', `Livres — ${letter}`);

      for (const book of groups.get(letter)!) {
        const inCollection = book.collection !== null;
        const searchValue = book.collection
          ? `${book.collection.name} ${book.title} ${book.authors.join(' ')}`
          : `${book.title} ${book.authors.join(' ')}`;
        const li = createBookListItem(book, book.cover, searchValue, loggedIn, { inCollection });
        if (book.collection) {
          li.dataset.collectionMember = book.collection.slug;
        }
        ul.appendChild(li);
      }

      section.appendChild(ul);
      fragment.appendChild(section);
    }

    container.appendChild(fragment);
    if (loading) loading.hidden = true;
    if (count) count.textContent = `(${totalBooks})`;

    if (nav) observeLetterSections(container, nav);

    // Masquer les sections vides lors d'une recherche
    document.getElementById('search-input')?.addEventListener('input', () => {
      updateSectionVisibility();
    });

    // Suppression d'un livre
    addPageScopedListener<CustomEvent<{ id: string }>>(document, 'book-deleted', (e) => {
      const { id } = e.detail;
      const li = container.querySelector(`li[data-book-id="${id}"]`);
      if (li) {
        const section = li.closest<HTMLElement>('[data-letter-section]');
        li.remove();

        // Retirer la section si elle est vide
        if (section && section.querySelectorAll('li').length === 0) {
          const letter = section.dataset.letterSection!;
          section.remove();
          document.querySelector(`[data-letter-nav="${letter}"]`)?.remove();
        }
      }

      totalBooks--;
      if (count) count.textContent = totalBooks > 0 ? `(${totalBooks})` : '';
      if (totalBooks === 0 && empty) empty.hidden = false;
    });

    // Mise à jour cover après upload
    addPageScopedListener<CustomEvent<{ id: string; coverUrl: string }>>(
      document,
      'book-cover-updated',
      (e) => {
        const { id, coverUrl } = e.detail;
        const li = container.querySelector<HTMLElement>(`li[data-book-id="${id}"]`);
        if (!li) return;
        li.dataset.coverUrl = coverUrl;
        const card = li.querySelector<HTMLElement>('.c-bookcard');
        if (card) updateCardCover(card, coverUrl);
      },
    );
  });
</script>
