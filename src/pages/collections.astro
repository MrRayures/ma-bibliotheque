---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CollectionDialog from '../components/CollectionDialog.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Collections — Ma Bibliothèque"
  description="Vue par collections de ma bibliothèque personnelle"
>
  <div class="mx-auto max-w-5xl px-4 pt-3 pb-28">
    <PageHeader title="Collections" countId="collection-count" searchPlaceholder="Rechercher une collection..." />

    <div id="collections-container" class="c-book-grid mt-6 flex flex-col gap-10"></div>
    <div id="collections-loading" class="c-book-grid mt-6 flex flex-col gap-10" aria-label="Chargement en cours" aria-busy="true">
      {Array.from({ length: 2 }).map(() => (
        <div>
          <div class="mb-4">
            <div class="mb-2 h-5 w-44 animate-pulse rounded bg-neutral-200"></div>
            <div class="h-3 w-16 animate-pulse rounded bg-neutral-200"></div>
          </div>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(var(--card-size),1fr))] gap-3">
            {Array.from({ length: 6 }).map(() => (
              <div class="aspect-square animate-pulse rounded-lg bg-neutral-200"></div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="collections-empty" class="mt-16 flex flex-col items-center gap-4 text-center" hidden>
      <p class="text-sm">C'est vide par ici ! <br>Ajouter un livre en cliquant sur le bouton ci-dessous.</p>
    </div>
  </div>

  <CollectionDialog />

  <template id="tpl-icon-list"><Icon name="list-view" size={16} /></template>
  <template id="tpl-icon-grid"><Icon name="grid-view" size={16} /></template>
  <template id="tpl-icon-edit"><Icon name="edit" size={16} /></template>
</BaseLayout>

<script>
  import type { Book } from '../types/library';
import { getAllBooks } from '../utils/api';
import { isLoggedIn } from '../utils/auth';
import type { ViewMode } from '../utils/books';
import { getCollectionViewMode, getLetterKey, groupByCollection, setCollectionViewMode } from '../utils/books';
import { buildLetterNav, createBookListItem, observeLetterSections, updateCardCover } from '../utils/render';

  document.addEventListener('astro:page-load', async () => {
    const UL_GRID    = 'grid grid-cols-[repeat(auto-fill,minmax(var(--card-size),1fr))] gap-3';
    const UL_COMPACT = 'flex gap-3 overflow-x-auto pb-2';

    function updateSectionVisibility(): void {
      document.querySelectorAll<HTMLElement>('[data-letter-section]').forEach((ls) => {
        const hasVisible = [...ls.querySelectorAll<HTMLElement>('[data-search]')].some(
          (item) => !item.hidden,
        );
        ls.hidden = !hasVisible;

        const letter = ls.dataset.letterSection!;
        const navLink = document.querySelector<HTMLElement>(`[data-letter-nav="${letter}"]`);
        if (navLink) {
          navLink.classList.toggle('opacity-30', !hasVisible);
          navLink.classList.toggle('pointer-events-none', !hasVisible);
        }
      });
    }

    function cloneIcon(id: string): Node {
      const tpl = document.getElementById(id) as HTMLTemplateElement;
      return tpl.content.cloneNode(true);
    }

    function hasMultipleRows(ul: HTMLUListElement): boolean {
      const first = ul.querySelector<HTMLElement>('li');
      const last = ul.querySelector<HTMLElement>('li:last-child');
      if (!first || !last || first === last) return false;
      return first.offsetTop !== last.offsetTop;
    }

    function updateToggleVisibility(section: HTMLElement): void {
      const btn = section.querySelector<HTMLButtonElement>('[data-view-toggle]');
      const ul = section.querySelector<HTMLUListElement>('ul[role="list"]');
      if (!btn || !ul) return;

      const wasCompact = ul.classList.contains('overflow-x-auto');
      if (wasCompact) {
        ul.className = UL_GRID;
        ul.querySelectorAll<HTMLElement>('li').forEach((li) => {
          li.classList.remove('shrink-0');
          li.style.width = '';
        });
      }

      const visible = hasMultipleRows(ul);
      btn.hidden = !visible;

      if (wasCompact && visible) {
        ul.className = UL_COMPACT;
        ul.querySelectorAll<HTMLElement>('li').forEach((li) => {
          li.classList.add('shrink-0');
          li.style.width = 'var(--card-size)';
        });
      }

      if (!visible && wasCompact) {
        const slug = section.dataset.collectionSlug ?? '';
        setCollectionViewMode(slug, 'grid');
        applyModeToSection('grid', section, btn);
      }
    }

    function applyModeToSection(mode: ViewMode, section: HTMLElement, btn: HTMLButtonElement): void {
      const ul = section.querySelector<HTMLUListElement>('ul[role="list"]');
      if (!ul) return;

      if (mode === 'compact') {
        ul.className = UL_COMPACT;
        ul.querySelectorAll<HTMLElement>('li').forEach((li) => {
          li.classList.add('shrink-0');
          li.style.width = 'var(--card-size)';
        });
        btn.replaceChildren(cloneIcon('tpl-icon-grid'));
        btn.setAttribute('aria-label', 'Passer en mode grille');
      } else {
        ul.className = UL_GRID;
        ul.querySelectorAll<HTMLElement>('li').forEach((li) => {
          li.classList.remove('shrink-0');
          li.style.width = '';
        });
        btn.replaceChildren(cloneIcon('tpl-icon-list'));
        btn.setAttribute('aria-label', 'Passer en mode compact');
      }
    }

    function createCollectionSection(name: string, slug: string, books: Book[], loggedIn: boolean): HTMLElement {
      const section = document.createElement('section');
      section.dataset.collection = '';
      section.dataset.collectionSlug = slug;
      section.dataset.search = name.toLowerCase();

      const header = document.createElement('div');
      header.className = 'mb-4';

      const row = document.createElement('div');
      row.className = 'flex items-center gap-2';

      const heading = document.createElement('h2');
      heading.className = 'text-2xl font-bold';
      const total = books[0]?.collection?.totalVolumes;
      const incomplete = total != null && total > 0 && books.length !== total;
      heading.textContent = incomplete ? `📚 ${name}` : name;
      row.appendChild(heading);

      if (loggedIn) {
        const renameBtn = document.createElement('button');
        renameBtn.type = 'button';
        renameBtn.setAttribute('aria-label', `Renommer ${name}`);
        renameBtn.className = 'c-btn c-btn--secondary-outline c-btn--icon-sm shrink-0';
        renameBtn.appendChild(cloneIcon('tpl-icon-edit'));
        renameBtn.addEventListener('click', () => {
          document.dispatchEvent(
            new CustomEvent('open-collection-dialog', {
              detail: { slug, name, totalVolumes: total ?? null },
            }),
          );
        });
        row.appendChild(renameBtn);
      }

      const toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.dataset.viewToggle = '';
      toggleBtn.className = 'c-btn c-btn--secondary-outline c-btn--icon-sm ml-auto';
      toggleBtn.appendChild(cloneIcon('tpl-icon-list'));
      toggleBtn.setAttribute('aria-label', 'Passer en mode compact');
      toggleBtn.addEventListener('click', () => {
        const currentMode = getCollectionViewMode(slug);
        const nextMode: ViewMode = currentMode === 'grid' ? 'compact' : 'grid';
        setCollectionViewMode(slug, nextMode);
        applyModeToSection(nextMode, section, toggleBtn);
      });
      row.appendChild(toggleBtn);

      header.appendChild(row);

      const subtitle = document.createElement('span');
      subtitle.className = 'text-sm text-text-light font-normal';
      subtitle.textContent =
        total && total > 0 ? ` (${books.length}/${total})` : ` (${books.length})`;
      heading.appendChild(subtitle);

      section.appendChild(header);
      return section;
    }

    // ─── Init ──────────────────────────────────────────────────────────────────────

    const books = await getAllBooks();
    const collections = groupByCollection(books);
    const container = document.getElementById('collections-container');
    const loading = document.getElementById('collections-loading');
    const empty = document.getElementById('collections-empty');
    const countEl = document.getElementById('collection-count');
    const loggedIn = isLoggedIn();

    if (!container) return;

    if (collections.size === 0) {
      if (loading) loading.hidden = true;
      if (empty) empty.hidden = false;
      return;
    }

    // Grouper les collections par lettre
    const letterGroups = new Map<string, [string, Book[]][]>();
    for (const [slug, collectionBooks] of collections) {
      const name = collectionBooks[0]?.collection?.name ?? '';
      const letter = getLetterKey(name);
      if (!letterGroups.has(letter)) letterGroups.set(letter, []);
      letterGroups.get(letter)!.push([slug, collectionBooks]);
    }

    const sortedLetters = [...letterGroups.keys()].sort((a, b) => {
      if (a === '#') return 1;
      if (b === '#') return -1;
      return a.localeCompare(b, 'fr');
    });

    const nav = document.getElementById('letter-nav');
    if (nav) buildLetterNav(nav, new Set(sortedLetters));

    for (const letter of sortedLetters) {
      const letterSection = document.createElement('div');
      letterSection.dataset.letterSection = letter;

      const letterHeading = document.createElement('h2');
      letterHeading.id = `lettre-${letter}`;
      letterHeading.className = 'mb-3 font-semibold uppercase tracking-widest scroll-mt-20';
      letterHeading.textContent = letter;
      letterSection.appendChild(letterHeading);

      const collectionsInLetter = letterGroups.get(letter)!;
      collectionsInLetter.sort((a, b) => {
        const nameA = a[1][0]?.collection?.name ?? '';
        const nameB = b[1][0]?.collection?.name ?? '';
        return nameA.localeCompare(nameB, 'fr', { sensitivity: 'base' });
      });

      for (const [slug, collectionBooks] of collectionsInLetter) {
        const name = collectionBooks[0]?.collection?.name ?? '';
        const section = createCollectionSection(name, slug, collectionBooks, loggedIn);

        const grid = document.createElement('ul');
        grid.className = UL_GRID;
        grid.setAttribute('role', 'list');

        for (const book of collectionBooks) {
          const li = createBookListItem(book, book.cover, book.title.toLowerCase(), loggedIn, { inCollection: true });
          li.removeAttribute('data-search');
          grid.appendChild(li);
        }

        section.appendChild(grid);
        letterSection.appendChild(section);

        const savedMode = getCollectionViewMode(slug);
        const btn = section.querySelector<HTMLButtonElement>('[data-view-toggle]');
        if (btn) applyModeToSection(savedMode, section, btn);
      }

      container.appendChild(letterSection);
    }

    if (nav) observeLetterSections(container, nav);

    document.addEventListener('book-deleted', (e) => {
      const { id } = (e as CustomEvent<{ id: string }>).detail;
      const li = container.querySelector(`li[data-book-id="${id}"]`);
      const section = li?.closest('section');
      li?.remove();
      if (section && section.querySelectorAll('li').length === 0) section.remove();
      const remaining = container.querySelectorAll('section').length;
      if (countEl) countEl.textContent = remaining > 0 ? `(${remaining})` : '';
    });

    document.addEventListener('book-cover-updated', (e) => {
      const { id, coverUrl } = (e as CustomEvent<{ id: string; coverUrl: string }>).detail;
      const li = container.querySelector<HTMLElement>(`li[data-book-id="${id}"]`);
      if (!li) return;
      li.dataset.coverUrl = coverUrl;
      const card = li.querySelector<HTMLElement>('.c-bookcard');
      if (card) updateCardCover(card, coverUrl);
    });

    if (loading) loading.hidden = true;
    if (countEl) countEl.textContent = `(${collections.size})`;

    function refreshAllToggles(): void {
      container.querySelectorAll<HTMLElement>('section[data-collection]').forEach(updateToggleVisibility);
    }

    refreshAllToggles();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(refreshAllToggles, 150);
    });

    document.getElementById('search-input')?.addEventListener('input', () => {
      updateSectionVisibility();
    });

    document.addEventListener('collection-updated', () => {
      sessionStorage.setItem('collections-scroll', String(window.scrollY));
      window.location.reload();
    });

    const savedScroll = sessionStorage.getItem('collections-scroll');
    if (savedScroll !== null) {
      sessionStorage.removeItem('collections-scroll');
      window.scrollTo({ top: Number(savedScroll), behavior: 'instant' });
    }
  });
</script>
