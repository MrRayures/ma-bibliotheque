---
import BaseLayout from '../layouts/BaseLayout.astro';
import BarcodeScanner from '../components/BarcodeScanner.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout title="Ajouter un livre — Ma Bibliothèque">
  <BarcodeScanner />

  <div class="mx-auto max-w-lg px-4 pb-28 pt-3">

    <h1 id="edit-heading" class="mb-6 text-2xl font-bold hidden">Modifier le livre</h1>

    <details id="search-book" class="c-accordion mb-6">
      <summary class="c-accordion-summary">Rechercher un livre</summary>
      <div class="c-accordion-content">
        <div>
          <label for="ean-input" class="mb-1 block text-sm font-medium">
            EAN / ISBN
          </label>
          <div class="flex gap-2">
            <input
              type="text"
              id="ean-input"
              inputmode="numeric"
              maxlength="13"
              placeholder="9782..."
              autocomplete="off"
              class="c-input flex-1 py-2.5 font-mono"
            />
            <Button id="search-btn" variant="secondary" size="md">
              <Icon name="search" size={16} slot="icon" />
            </Button>
          </div>
        </div>
        <div class="flex items-center gap-2 text-text-light">
          <hr class="flex-1 border-2 border-border" />
          <span>ou</span>
          <hr class="flex-1 border-2 border-border" />
        </div>
        <div>
          <label for="title-search-input" class="mb-1 block text-sm font-medium">
            Titre
          </label>
          <div class="flex gap-2">
            <input
              type="text"
              id="title-search-input"
              placeholder="ex : Astérix"
              autocomplete="off"
              class="c-input flex-1 py-2.5"
            />
            <Button id="title-search-btn" variant="secondary" size="md">
              <Icon name="search" size={16} slot="icon" />
            </Button>
          </div>
        </div>
        <div class="flex items-center gap-2 text-text-light">
          <hr class="flex-1 border-2 border-border" />
          <span>ou</span>
          <hr class="flex-1 border-2 border-border" />
        </div>
        <Button class="w-full" id="scan-btn" variant="primary" size="lg" iconPosition="left">
          <Icon name="scan" size={16} slot="icon" />
          Scanner
        </Button>
      </div>
    </details>

    <!-- Zone d'alerte -->
    <div id="alert-zone" class="mb-6 hidden" role="alert" aria-live="polite"></div>

    <!-- Aperçu livre existant (doublon) -->
    <div id="existing-book-preview" class="mb-6 hidden"></div>

    <!-- Infos livre -->
    <div id="book-info" class="mb-6 ">
      <div class="flex gap-4">
        <div class="flex shrink-0 flex-col items-center gap-1">
          <div
            id="cover-preview"
            class="relative h-30 w-22 overflow-hidden rounded-lg bg-primary border-2 border-secondary flex items-center justify-center"
          >
            <Logo id="cover-logo" size={40} eye="question" class="opacity-50" />
          </div>
          <Button
            id="cover-upload-btn"
            variant="secondary"
            size="sm"
            class="hidden"
          >
            Ajouter
          </Button>
        </div>
        <input
          type="file"
          id="cover-file-input"
          accept="image/*"
          class="hidden"
          capture="environment"
          aria-label="Sélectionner une image de couverture"
        />
        <div class="flex min-w-0 flex-1 flex-col gap-3">
          <div>
            <label for="book-ean-input" class="mb-1 block text-sm font-medium">
              EAN / ISBN <span class="text-alert">*</span>
            </label>
            <input
              type="text"
              id="book-ean-input"
              name="ean"
              inputmode="numeric"
              maxlength="13"
              required
              class="c-input--readonly font-mono"
            />
          </div>
          <div>
            <label for="title-input" class="mb-1 block text-sm font-medium ">
              Titre <span class="text-alert">*</span>
            </label>
            <input
              type="text"
              id="title-input"
              name="title"
              required
              class="c-input--readonly"
            />
          </div>
          <div>
            <label for="subtitle-input" class="mb-1 block text-sm font-medium ">
              Sous-titre <span class="font-normal text-text-light">(optionnel)</span>
            </label>
            <input
              type="text"
              id="subtitle-input"
              name="subtitle"
              class="c-input--readonly"
            />
          </div>
          <div>
            <label for="authors-input" class="mb-1 block text-sm font-medium ">
              Auteur(s) <span class="font-normal text-text-light">(optionnel)</span>
            </label>
            <input
              type="text"
              id="authors-input"
              name="authors"
              placeholder="ex : René Goscinny, Albert Uderzo"
              class="c-input--readonly"
            />
          </div>
          <div>
            <label for="publisher-input" class="mb-1 block text-sm font-medium">
              Éditeur <span class="font-normal text-text-light">(optionnel)</span>
            </label>
            <input
              type="text"
              id="publisher-input"
              name="publisher"
              placeholder="ex : Glénat"
              class="c-input--readonly"
            />
          </div>
          <div>
            <label for="publish-date-input" class="mb-1 block text-sm font-medium">
              Date de publication <span class="font-normal text-text-light">(optionnel)</span>
            </label>
            <input
              type="text"
              id="publish-date-input"
              name="publishDate"
              placeholder="ex : Aug 28, 2013"
              class="c-input--readonly"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Champs supplémentaires -->
    <div id="extra-fields" class="hidden">
      <div class="mb-4">
        <p class="mb-2 text-md font-medium">
          Collection <span class="font-normal text-text-light">(optionnel)</span>
        </p>

        <!-- Nouvelle collection -->
        <div class="mb-2">
          <!-- Séparateur + select collections existantes (masqués si aucune) -->
          <div id="collection-existing-wrapper" class="hidden">
            <label for="collection-select" class="mb-1 block text-sm font-medium ">
              Ajouter à une collection existante
            </label>
            <select
              id="collection-select"
              class="c-select bg-white"
            >
              <option value="">— Sélectionner —</option>
            </select>
            <div class="my-2 flex items-center gap-2 text-text-light">
              <hr class="flex-1 border-2 border-white" />
              <span>ou</span>
              <hr class="flex-1 border-2 border-white" />
            </div>
          </div>

          <label for="collection-input" class="mb-1 block text-sm font-medium">
            Nouvelle collection
          </label>
          <input
            type="text"
            id="collection-input"
            name="collection"
            placeholder="ex : Astérix"
            autocomplete="off"
            class="c-input"
          />
        </div>
      </div>

      <div id="volume-row" class="mb-6 hidden">
        <label for="volume-input" class="mb-1 block text-sm font-medium ">
          Numéro de tome
        </label>
        <input
          type="number"
          id="volume-input"
          name="volume"
          min="1"
          placeholder="1, 2, 3..."
          class="c-input w-32"
        />
      </div>

    </div>

    <!-- État : succès -->
    <div id="state-success" class="mt-4 hidden">
      <div class="c-alert c-alert--success mb-4">
        <p class="text-sm font-medium">Livre ajouté avec succès !</p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="flex gap-4">
          <Button class="w-full" id="view-book-btn" variant="secondary-outline" size="lg">
            Voir le livre
          </Button>
          <Button class="w-full" href="/" variant="secondary-outline" size="lg">
            Ma bibliothèque
        </Button>
        </div>
        <Button class="w-full" id="add-another-btn" variant="secondary" size="lg">
          Ajouter un autre livre
        </Button>
      </div>
    </div>
  </div>

  <!-- Barre d'actions fixe -->
  <div
    id="form-actions"
    class="fixed bottom-0 left-0 right-0 border-t border-neutral-200 bg-white px-4 py-3 shadow-[0_-1px_8px_rgba(0,0,0,0.06)]"
  >
    <div class="mx-auto flex max-w-lg gap-3">
      <Button id="cancel-btn" href="/" variant="secondary-outline" size="lg" class="flex-1">
        Annuler
      </Button>
      <Button id="submit-btn" variant="primary" size="lg" class="flex-1">
        Ajouter
      </Button>
    </div>
  </div>

  <template id="tpl-icon-loading"><Icon name="loading" size={16} class="animate-spin" /></template>

  <!-- Modale résultats recherche par titre -->
  <dialog
    id="search-results-dialog"
    class="c-dialog c-dialog--md"
    aria-labelledby="search-results-title"
  >
    <div class="c-dialog__header sticky top-0 bg-white">
      <h2 id="search-results-title" class="c-dialog__title">Résultats</h2>
      <Button id="search-results-close" variant="ghost" size="lg" aria-label="Fermer">
        <Icon name="close" size={18} slot="icon" />
      </Button>
    </div>
    <div id="search-results-body" class="c-dialog__body">
    </div>
  </dialog>
</BaseLayout>

<script>
  import type { Book } from '../types/library';
import { getBookByEan, getBookById, getCollectionNames, saveBook, uploadCover, uploadCoverFile } from '../utils/api';
import { isLoggedIn } from '../utils/auth';
import { resizeImage } from '../utils/image';
import type { SearchProgress, SearchResult } from '../utils/openLibrary';
import { slugify } from '../utils/books';
import { buildBook, extractCollectionName, extractVolume, lookupByEan, searchByTitle } from '../utils/openLibrary';
import { translateToFrench } from '../utils/translate';

  document.addEventListener('astro:page-load', async () => {
    // ─── Guard auth ──────────────────────────────────────────────────────────────

    if (!isLoggedIn()) {
      window.location.replace('/');
      return;
    }

    // ─── Éléments DOM : recherche ────────────────────────────────────────────────

    const searchAccordion = document.getElementById('search-book') as HTMLDetailsElement;
    const eanInput = document.getElementById('ean-input') as HTMLInputElement;
    const titleSearchInput = document.getElementById('title-search-input') as HTMLInputElement;
    const titleSearchBtn = document.getElementById('title-search-btn')!;
    const scanBtn = document.getElementById('scan-btn')!;
    const searchBtn = document.getElementById('search-btn')!;
    const alertZone = document.getElementById('alert-zone')!;
    const existingBookPreview = document.getElementById('existing-book-preview')!;
    const searchResultsDialog = document.getElementById('search-results-dialog') as HTMLDialogElement;
    const searchResultsBody = document.getElementById('search-results-body')!;
    const searchResultsClose = document.getElementById('search-results-close')!;

    // ─── Éléments DOM : formulaire livre ─────────────────────────────────────────

    const bookInfo = document.getElementById('book-info')!;
    const extraFields = document.getElementById('extra-fields')!;
    const coverPreview = document.getElementById('cover-preview')!;
    const coverLogo = document.getElementById('cover-logo')!;
    const coverUploadBtn = document.getElementById('cover-upload-btn') as HTMLButtonElement;
    const coverFileInput = document.getElementById('cover-file-input') as HTMLInputElement;
    const bookEanInput = document.getElementById('book-ean-input') as HTMLInputElement;
    const titleInput = document.getElementById('title-input') as HTMLInputElement;
    const subtitleInput = document.getElementById('subtitle-input') as HTMLInputElement;
    const authorsInput = document.getElementById('authors-input') as HTMLInputElement;
    const publisherInput = document.getElementById('publisher-input') as HTMLInputElement;
    const publishDateInput = document.getElementById('publish-date-input') as HTMLInputElement;
    const volumeInput = document.getElementById('volume-input') as HTMLInputElement;
    const volumeRow = document.getElementById('volume-row')!;

    // ─── Éléments DOM : collection ───────────────────────────────────────────────

    const collectionInput = document.getElementById('collection-input') as HTMLInputElement;
    const collectionSelect = document.getElementById('collection-select') as HTMLSelectElement;
    const collectionExistingWrapper = document.getElementById('collection-existing-wrapper')!;

    // ─── Éléments DOM : actions ──────────────────────────────────────────────────

    const submitBtn = document.getElementById('submit-btn')!;
    const formActions = document.getElementById('form-actions')!;
    const stateSuccess = document.getElementById('state-success')!;
    const viewBookBtn = document.getElementById('view-book-btn')!;
    const addAnotherBtn = document.getElementById('add-another-btn')!;

    // ─── State ───────────────────────────────────────────────────────────────────

    const editId = new URLSearchParams(location.search).get('id');
    const submitBtnText = submitBtn.textContent ?? '';
    let pendingCoverUrl: string | null = null;
    let pendingCoverBlob: Blob | null = null;
    let pendingOpenLibraryUrl: string | null = null;
    let isManual = false;

    // ─── Helpers UI ──────────────────────────────────────────────────────────────

    function escHtml(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function showAlert(msg: string, type: 'alert' | 'success' | 'info' = 'info'): void {
      const modifier = type === 'info' ? '' : ` c-alert--${type}`;
      alertZone.className = `mb-6 c-alert${modifier}`;
      alertZone.innerHTML = `<p class="text-sm font-medium">${msg}</p>`;
    }

    function hideAlert(): void {
      alertZone.className = 'mb-6 hidden';
      alertZone.innerHTML = '';
      hideExistingBook();
    }

    function showExistingBook(book: Book): void {
      const coverUrl = book.cover;
      const coverHtml = coverUrl
        ? `<img src="${escHtml(coverUrl)}" alt="" class="h-full w-full object-cover" />`
        : `<span class="text-lg font-bold text-text-light">${escHtml((book.title[0] ?? '?').toUpperCase())}</span>`;
      existingBookPreview.innerHTML = `
        <a href="/ajouter?id=${escHtml(book.id)}" class="c-search-result">
          <div class="c-search-result-cover">${coverHtml}</div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium">${escHtml(book.title)}</p>
            <p class="truncate text-xs text-text-light">${escHtml(book.authors.join(', ') || 'Auteur inconnu')}</p>
            ${book.ean ? `<p class="mt-1 font-mono text-xs text-text-light">${escHtml(book.ean)}</p>` : ''}
          </div>
        </a>`;
      existingBookPreview.classList.remove('hidden');
    }

    function hideExistingBook(): void {
      existingBookPreview.classList.add('hidden');
      existingBookPreview.innerHTML = '';
    }

    function showForm(): void {
      bookInfo.classList.remove('hidden');
      extraFields.classList.remove('hidden');
    }

    function hideForm(): void {
      bookInfo.classList.add('hidden');
      extraFields.classList.add('hidden');
    }

    function showSuccessState(book: Book): void {
      hideForm();
      hideAlert();
      searchAccordion.classList.add('hidden');
      formActions.classList.add('hidden');
      stateSuccess.classList.remove('hidden');
      viewBookBtn.onclick = () => {
        document.dispatchEvent(new CustomEvent('open-book-dialog', {
          detail: { book, coverUrl: book.cover, isLoggedIn: true },
        }));
      };
    }

    function setCoverPreview(url: string): void {
      coverLogo.classList.add('hidden');
      coverUploadBtn.classList.add('hidden');
      const existing = coverPreview.querySelector('img') as HTMLImageElement | null;
      if (existing) {
        if (existing.src.startsWith('blob:')) URL.revokeObjectURL(existing.src);
        existing.remove();
      }
      const oldLoader = coverPreview.querySelector('[data-cover-loader]');
      if (oldLoader) oldLoader.remove();

      const tpl = document.getElementById('tpl-icon-loading') as HTMLTemplateElement;
      const loader = document.createElement('div');
      loader.setAttribute('data-cover-loader', '');
      loader.className = 'absolute inset-0 flex items-center justify-center';
      loader.appendChild(tpl.content.cloneNode(true));
      coverPreview.appendChild(loader);

      const img = document.createElement('img');
      img.alt = '';
      img.className = 'h-full w-full object-cover';
      img.onload = () => loader.remove();
      img.onerror = () => loader.remove();
      img.src = url;
      coverPreview.appendChild(img);
    }

    function resetCoverPreview(): void {
      const img = coverPreview.querySelector('img');
      if (img) img.remove();
      coverLogo.classList.remove('hidden');
      coverUploadBtn.classList.add('hidden');
    }

    function showCoverUploadBtn(): void {
      coverLogo.classList.add('hidden');
      coverUploadBtn.classList.remove('hidden');
    }

    coverUploadBtn.addEventListener('click', () => coverFileInput.click());

    coverFileInput.addEventListener('change', async () => {
      const file = coverFileInput.files?.[0];
      if (!file) return;
      const blob = await resizeImage(file, 300);
      if (!blob) { showAlert('Impossible de lire cette image.', 'alert'); return; }
      pendingCoverBlob = blob;
      pendingCoverUrl = null;
      setCoverPreview(URL.createObjectURL(blob));
      if (editId) {
        coverUploadBtn.textContent = 'Modifier';
        coverUploadBtn.classList.remove('hidden');
      }
    });

    function setSubmitLoading(loading: boolean): void {
      (submitBtn as HTMLButtonElement).disabled = loading;
      if (loading) {
        const tpl = document.getElementById('tpl-icon-loading') as HTMLTemplateElement;
        submitBtn.textContent = '';
        submitBtn.appendChild(tpl.content.cloneNode(true));
        submitBtn.append('Enregistrement…');
      } else {
        submitBtn.textContent = submitBtnText;
      }
    }

    // ─── Helpers formulaire ──────────────────────────────────────────────────────

    function resetBookFields(): void {
      resetCoverPreview();
      pendingCoverUrl = null;
      pendingCoverBlob = null;
      coverFileInput.value = '';
      pendingOpenLibraryUrl = null;
      bookEanInput.value = '';
      bookEanInput.readOnly = false;
      titleInput.value = '';
      titleInput.readOnly = false;
      subtitleInput.value = '';
      subtitleInput.readOnly = false;
      authorsInput.value = '';
      authorsInput.readOnly = false;
      publisherInput.value = '';
      publisherInput.readOnly = false;
      publishDateInput.value = '';
      publishDateInput.readOnly = false;
      volumeInput.value = '';
      volumeRow.classList.add('hidden');
      collectionInput.value = '';
      collectionSelect.value = '';
    }

    function enableManualEntry(ean: string): void {
      bookEanInput.value = ean;
      bookEanInput.readOnly = false;
      titleInput.readOnly = false;
      subtitleInput.readOnly = false;
      authorsInput.readOnly = false;
      publisherInput.readOnly = false;
      publishDateInput.readOnly = false;
      isManual = true;
      showForm();
      searchAccordion.open = false;
    }

    async function fillBookFromResult(result: NonNullable<Awaited<ReturnType<typeof lookupByEan>>>, ean: string): Promise<void> {
      isManual = false;

      const [title, subtitle, ...translatedAuthors] = await Promise.all([
        translateToFrench(result.title),
        result.subtitle ? translateToFrench(result.subtitle) : Promise.resolve(''),
        ...result.authors.map((a) => translateToFrench(a)),
      ]);

      bookEanInput.value = ean;
      titleInput.value = title;
      subtitleInput.value = subtitle;
      authorsInput.value = translatedAuthors.join(', ');
      publisherInput.value = result.publisher ?? '';
      publishDateInput.value = result.publishDate ?? '';

      const detectedVolume = extractVolume(result.title);
      if (detectedVolume !== null) {
        volumeInput.value = String(detectedVolume);
        volumeRow.classList.remove('hidden');

        const detectedCollection = extractCollectionName(title);
        if (detectedCollection) {
          await refreshCollectionSelect();
          const existingOption = [...collectionSelect.options].find((o) => o.value === detectedCollection);
          if (existingOption) {
            collectionSelect.value = detectedCollection;
          } else {
            collectionInput.value = detectedCollection;
          }
        }
      }

      pendingCoverUrl = result.coverUrl;
      pendingOpenLibraryUrl = result.openLibraryUrl;
      if (result.coverUrl) {
        setCoverPreview(result.coverUrl);
      } else {
        showCoverUploadBtn();
      }

      showForm();
      searchAccordion.open = false;
    }

    async function resetForm(): Promise<void> {
      eanInput.value = '';
      resetBookFields();
      isManual = false;
      hideForm();
      hideAlert();
      stateSuccess.classList.add('hidden');
      searchAccordion.classList.remove('hidden');
      searchAccordion.open = true;
      formActions.classList.remove('hidden');
      await refreshCollectionSelect();
    }

    // ─── Collections ─────────────────────────────────────────────────────────────

    async function refreshCollectionSelect(preselect: string | null = null): Promise<void> {
      const names = await getCollectionNames();
      if (names.length === 0) {
        collectionExistingWrapper.classList.add('hidden');
        return;
      }
      collectionExistingWrapper.classList.remove('hidden');
      collectionSelect.innerHTML =
        '<option value="">— Sélectionner —</option>' +
        names.map((n) => `<option value="${n}">${n}</option>`).join('');
      if (preselect) {
        collectionSelect.value = preselect;
        collectionInput.value = '';
      }
    }

    function activeCollection(): string {
      return collectionSelect.value || collectionInput.value.trim();
    }

    collectionInput.addEventListener('input', () => {
      if (collectionInput.value.trim()) collectionSelect.value = '';
      volumeRow.classList.toggle('hidden', activeCollection() === '');
    });

    collectionSelect.addEventListener('change', () => {
      if (collectionSelect.value) collectionInput.value = '';
      volumeRow.classList.toggle('hidden', activeCollection() === '');
    });

    // ─── Recherche ───────────────────────────────────────────────────────────────

    async function triggerLookup(ean: string, fallbackCoverUrl: string | null = null): Promise<void> {
      resetBookFields();
      hideAlert();
      hideForm();
      stateSuccess.classList.add('hidden');
      showAlert('Recherche en cours…');

      try {
        const existing = await getBookByEan(ean);
        if (existing) {
          showAlert('Ce livre est déjà dans ta bibliothèque.', 'alert');
          showExistingBook(existing);
          return;
        }

        const result = await lookupByEan(ean);

        if (!result || !result.title) {
          showAlert('Introuvable — renseignez les informations manuellement.', 'info');
          enableManualEntry(ean);
          return;
        }

        if (!result.coverUrl && fallbackCoverUrl) {
          result.coverUrl = fallbackCoverUrl;
        }

        showAlert('Livre trouvé ! Vérifiez les informations et ajoutez le livre.', 'success');
        await fillBookFromResult(result, ean);
      } catch {
        showAlert('Erreur lors de la recherche. Veuillez réessayer.', 'alert');
      }
    }

    function triggerSearch(): void {
      const val = eanInput.value.trim();
      if (val.length === 13 && /^\d{13}$/.test(val)) {
        triggerLookup(val);
      } else {
        showAlert('Saisissez un EAN / ISBN à 13 chiffres.', 'alert');
      }
    }

    // ─── Recherche par titre ─────────────────────────────────────────────────────

    function renderSearchResults(results: SearchResult[]): void {
      if (results.length === 0) {
        searchResultsBody.innerHTML = '<p class="py-4 text-center text-sm text-text-light">Aucun résultat trouvé.</p>';
        return;
      }

      searchResultsBody.innerHTML = results
        .map(
          (r, i) => `
          <button
            type="button"
            class="c-search-result"
            data-index="${i}"
          >
            <div class="c-search-result-cover">
              ${r.coverUrl ? `<img src="${escHtml(r.coverUrl)}" alt="" class="h-full w-full object-cover" />` : ''}
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium">${escHtml(r.title)}</p>
              <p class="truncate text-xs text-text-light">${escHtml(r.authors.join(', ') || 'Auteur inconnu')}</p>
              ${r.ean ? `<p class="mt-1 font-mono text-xs text-text-light">${escHtml(r.ean)}</p>` : '<p class="mt-1 text-xs text-alert">Pas d\'ISBN</p>'}
            </div>
          </button>`,
        )
        .join('');
    }

    function renderProgress(progress: SearchProgress): void {
      if (progress.done) {
        renderSearchResults(progress.results);
        return;
      }
      const loadingHtml = `<p class="py-2 text-center text-xs text-text-light">Recherche sur ${progress.source}…</p>`;
      if (progress.results.length === 0) {
        searchResultsBody.innerHTML = loadingHtml;
      } else {
        renderSearchResults(progress.results);
        searchResultsBody.insertAdjacentHTML('beforeend', loadingHtml);
      }
    }

    async function triggerTitleSearch(): Promise<void> {
      const query = titleSearchInput.value.trim();
      if (!query) return;

      searchResultsBody.innerHTML = '';
      searchResultsDialog.showModal();

      let latestResults: SearchResult[] = [];

      const onClick = (e: Event) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.c-search-result');
        if (!btn) return;
        const idx = parseInt(btn.dataset.index ?? '', 10);
        const selected = latestResults[idx];
        if (!selected) return;

        searchResultsBody.removeEventListener('click', onClick);
        searchResultsDialog.close();

        if (selected.ean) {
          eanInput.value = selected.ean;
          triggerLookup(selected.ean, selected.coverUrl);
        } else {
          showAlert('Ce livre n\'a pas d\'ISBN — renseignez les informations manuellement.', 'info');
          enableManualEntry('');
          titleInput.value = selected.title;
          authorsInput.value = selected.authors.join(', ');
          pendingCoverUrl = selected.coverUrl;
          if (selected.coverUrl) {
            setCoverPreview(selected.coverUrl);
          } else {
            showCoverUploadBtn();
          }
        }
      };

      searchResultsBody.addEventListener('click', onClick);

      try {
        await searchByTitle(query, (progress) => {
          latestResults = progress.results;
          renderProgress(progress);
        });
      } catch {
        searchResultsBody.innerHTML = '<p class="py-4 text-center text-sm text-alert">Erreur lors de la recherche.</p>';
      }
    }

    // ─── Soumission ──────────────────────────────────────────────────────────────

    function collectFormData() {
      const ean = bookEanInput.value.trim();
      const title = titleInput.value.trim();
      const subtitle = subtitleInput.value.trim() || null;
      const authors = authorsInput.value.split(',').map((a) => a.trim()).filter(Boolean);
      const publisher = publisherInput.value.trim() || null;
      const publishDate = publishDateInput.value.trim() || null;
      const collection = activeCollection() || null;
      const volume = collection ? parseInt(volumeInput.value, 10) || 1 : null;
      return { ean, title, subtitle, authors, publisher, publishDate, collection, volume };
    }

    async function handleEdit(data: ReturnType<typeof collectFormData>): Promise<void> {
      const existing = await getBookById(editId!);
      if (!existing) {
        showAlert('Livre introuvable.', 'alert');
        return;
      }
      const collectionSlug = data.collection ? slugify(data.collection) : null;
      const updatedBook: Book = {
        ...existing,
        title: data.title,
        subtitle: data.subtitle,
        authors: data.authors,
        publisher: data.publisher,
        publishDate: data.publishDate,
        collection: data.collection && collectionSlug && data.volume !== null
          ? { name: data.collection, slug: collectionSlug, volume: data.volume }
          : null,
      };
      if (pendingCoverBlob) {
        updatedBook.cover = await uploadCoverFile(updatedBook.id, pendingCoverBlob);
      }
      await saveBook(updatedBook);
      navigateBack();
    }

    function navigateBack(): void {
      if (document.referrer.startsWith(window.location.origin)) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    }

    async function handleCreate(data: ReturnType<typeof collectFormData>): Promise<void> {
      const book = buildBook(
        {
          title: data.title,
          subtitle: data.subtitle,
          authors: data.authors,
          publisher: data.publisher,
          publishDate: data.publishDate,
          coverUrl: pendingCoverUrl,
          openLibraryUrl: pendingOpenLibraryUrl,
          ean: data.ean,
        },
        data.collection,
        data.volume,
      );
      if (pendingCoverBlob) {
        book.cover = await uploadCoverFile(book.id, pendingCoverBlob);
      } else if (pendingCoverUrl) {
        book.cover = await uploadCover(book.id, pendingCoverUrl);
      }
      await saveBook(book);
      showSuccessState(book);
    }

    async function handleSubmit(): Promise<void> {
      const data = collectFormData();

      if (!data.ean || !data.title) {
        showAlert('Veuillez renseigner un EAN / ISBN et un titre.', 'alert');
        return;
      }

      setSubmitLoading(true);
      try {
        if (editId) {
          await handleEdit(data);
        } else {
          await handleCreate(data);
        }
      } finally {
        setSubmitLoading(false);
      }
    }

    // ─── Event listeners ─────────────────────────────────────────────────────────

    scanBtn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-scanner'));
    });

    document.addEventListener('ean-detected', (e) => {
      const ean = (e as CustomEvent<{ ean: string }>).detail.ean;
      eanInput.value = ean;
      triggerLookup(ean);
    });

    searchBtn.addEventListener('click', triggerSearch);

    eanInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        triggerSearch();
      }
    });

    titleSearchBtn.addEventListener('click', triggerTitleSearch);

    titleSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        triggerTitleSearch();
      }
    });

    searchResultsClose.addEventListener('click', () => searchResultsDialog.close());
    searchResultsDialog.addEventListener('click', (e) => {
      if (e.target === searchResultsDialog) searchResultsDialog.close();
    });

    submitBtn.addEventListener('click', handleSubmit);
    addAnotherBtn.addEventListener('click', resetForm);

    document.getElementById('cancel-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      navigateBack();
    });

    // ─── Init ────────────────────────────────────────────────────────────────────

    if (editId) {
      const existing = await getBookById(editId);
      if (existing) {
        const editHeading = document.getElementById('edit-heading');
        if (editHeading) editHeading.classList.remove('hidden');
        searchAccordion.classList.add('hidden');
        submitBtn.textContent = 'Enregistrer';

        eanInput.value = existing.ean;
        eanInput.readOnly = true;
        bookEanInput.value = existing.ean;
        bookEanInput.readOnly = true;
        titleInput.value = existing.title;
        subtitleInput.value = existing.subtitle ?? '';
        authorsInput.value = existing.authors.join(', ');
        publisherInput.value = existing.publisher ?? '';
        publishDateInput.value = existing.publishDate ?? '';

        if (existing.collection) {
          volumeInput.value = String(existing.collection.volume);
          volumeRow.classList.remove('hidden');
        }

        const existingCoverUrl = existing.cover;
        if (existingCoverUrl) setCoverPreview(existingCoverUrl);
        coverLogo.classList.add('hidden');
        coverUploadBtn.textContent = existingCoverUrl ? 'Modifier' : 'Ajouter';
        coverUploadBtn.classList.remove('hidden');

        showForm();
        await refreshCollectionSelect(existing.collection?.name ?? null);
      }
    } else {
      await refreshCollectionSelect();
    }

    if (sessionStorage.getItem('open_scanner')) {
      sessionStorage.removeItem('open_scanner');
      document.dispatchEvent(new CustomEvent('open-scanner'));
    }
  });
</script>
